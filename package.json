{
	"name": "@darthsaul/vue-component-library",
	"version": "0.1.0",
	"description": "UI kit for Vue apps",
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"exports": {
		".": {
			"import": "./dist/index.js"
		},
		"./css": "./styles/src/index.scss",
		"./css/Button": "./styles/src/components/button.scss",
		"./css/Card": "./styles/src/components/card.scss",
		"./css/Alert": "./styles/src/components/alert.scss",
		"./css/Dropdown": "./styles/src/components/dropdown.scss",
		"./css/Input": "./styles/src/components/input.scss"
	},
	"files": [
		"dist",
		"styles"
	],
	"scripts": {
		"dev": "npm run dev --workspace=docs",
		"build": "npm run build --workspace=ui",
		"build:ui": "npm run build --workspace=ui",
		"build:docs": "npm run build --workspace=docs",
		"preview": "npm run preview --workspace=docs",
		"dev:css-demo": "npm run dev --workspace=css-demo",
		"build:css-demo": "npm run build --workspace=css-demo",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"keywords": [
		"vue",
		"component-library",
		"ui-kit",
		"vite"
	],
	"author": "",
	"license": "ISC",
	"workspaces": [
		"ui",
		"docs",
		"styles",
		"icons",
		"css-demo"
	],
	"devDependencies": {
		"@vitejs/plugin-vue": "5.2.4",
		"@vue/test-utils": "^2.4.11",
		"jsdom": "^29.1.1",
		"markdown-it": "^14.1.1",
		"pinia": "^3.0.4",
		"sass": "^1.94.2",
		"typescript": "^5.9.3",
		"vite": "6.4.1",
		"vite-plugin-vue-docgen": "^0.3.4",
		"vitest": "^4.1.10",
		"vue": "^3.4.0",
		"vue-component-meta": "^3.2.5",
		"vue-router": "^5.0.3"
	},
	"peerDependencies": {
		"vue": "^3.4.0"
	}
}
